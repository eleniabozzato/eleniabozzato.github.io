    "cordovado-medievale.html": {
      "settings": {
        "title": "Eventi | Cordovado Medievale",
        "order": "5",
        "meta_descr": "Cordovado Medievale: due giorni di spettacoli, cortei e sfide tra rioni per il Palio. Scopri come ho curato la comunicazione visiva e social dell’evento!",
        "meta_image": "@PROJECT_PATH@/assets/images/cordovado-medievale-2024-1201x1201.jpg"
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "& when not (@sticky)": {
